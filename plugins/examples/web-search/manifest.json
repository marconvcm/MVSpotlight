{
    "id": "org.mvspotlight.websearch",
    "name": "Web Search",
    "version": "1.0.0",
    "description": "Instant web searches for Google, GitHub, DuckDuckGo, and Wikipedia",
    "author": "Antigravity",
    "entry": "plugin.lua",
    "icon": "applications-internet",
    "minimumApiVersion": 1,
    "permissions": [
        "application.launch",
        "network"
    ],
    "settings": [
        {
            "key": "default_engine",
            "title": "Default Search Engine",
            "type": "choice",
            "choices": ["google", "duckduckgo", "bing", "kagi"],
            "choiceLabels": ["Google", "DuckDuckGo", "Bing", "Kagi"],
            "default": "google",
            "description": "Default search provider for 's <query>' or 'search <query>'"
        },
        {
            "key": "fallback_search",
            "title": "Enable General Web Fallback",
            "type": "boolean",
            "default": false,
            "description": "Suggest web search results when searching without a specific prefix"
        }
    ]
}
